# 값은 .env.local에만 넣는다. 이 파일에는 이름만 둔다. (CLAUDE.md 4장 규칙 8)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 코드에서만 사용. NEXT_PUBLIC_을 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 오픈 전에는 false(검색 차단: robots.txt 전체 Disallow + noindex). 오픈 날 Vercel 환경변수만 true로 바꾸고 다시 배포한다. (D-092)
NEXT_PUBLIC_SITE_LIVE=false
